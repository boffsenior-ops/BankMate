# Database Credentials
POSTGRES_USER=bankmate_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bankmate_db

# Redis Credentials
REDIS_PASSWORD=change_me_redis

# MinIO Credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecret_minio
MINIO_SECURE=false

# Qdrant Credentials
QDRANT_API_KEY=qdrant_secret_key

# === LLM providers ===
# Anthropic (primary)
ANTHROPIC_API_KEY=

# OpenAI (first fallback)
OPENAI_API_KEY=

# DeepSeek official (cheap & strong)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (gateway for Qwen + DeepSeek redundancy)
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-chat
OPENROUTER_QWEN_MODEL=qwen/qwen3-max

# Failover behavior
LLM_PROVIDER_ORDER=anthropic,openai,deepseek,deepseek_or,qwen
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES_PER_PROVIDER=2
LLM_COOLDOWN_RATE_LIMIT_MIN=5
LLM_COOLDOWN_AUTH_ERROR_MIN=1

# Security
JWT_SECRET=your_jwt_secret_key
